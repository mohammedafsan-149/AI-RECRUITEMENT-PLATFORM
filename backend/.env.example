PORT=5000
NODE_ENV=development

# =============================================================================
# SQL DATABASE CONFIGURATION (PostgreSQL / MySQL / SQLite)
# =============================================================================
# Option A: Local Development (Default: SQLite zero-config file)
# If DATABASE_URL is unset, the system automatically uses './database/recruitment.sqlite'

# Option B: Cloud Deployment (PostgreSQL on Supabase, Neon, Render, or Railway)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# DATABASE_URL=postgresql://USER:PASSWORD@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option C: Cloud Deployment (MySQL on AWS RDS or PlanetScale)
# DATABASE_URL=mysql://user:password@hostname:3306/recruitment_platform

# DB SSL setting (default true for cloud Postgres)
DB_SSL=true

# Optional MongoDB connection (if using dual-database architecture)
MONGO_URI=mongodb://127.0.0.1:27017/recruitment_platform

# App Secrets
JWT_SECRET=talent_ai_jwt_secret_key_2026
OPENAI_API_KEY=
